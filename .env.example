# Telegram
BOT_TOKEN=810831123123
BOT_OWNER_ID=123
CHECK_INTERVAL_MINUTES=2
HTTP_FAILURE_THRESHOLD=4
MAX_CONCURRENT_CHECKS=30
MONITOR_MAX_INSTANCES=1
MONITOR_HTTP_RETRIES=2
MONITOR_HTTP_TIMEOUT_SECONDS=10
MONITOR_HTTP_DELAY_SECONDS=2
MONITOR_CONFIRM_DOWN_ENABLED=1
MONITOR_CONFIRM_HTTP_RETRIES=2
MONITOR_CONFIRM_HTTP_TIMEOUT_SECONDS=10
MONITOR_CONFIRM_HTTP_DELAY_SECONDS=2

# Database
DB_NAME=devcheck
DB_USER=devuser
DB_PASS=devpass
DB_HOST=db
DB_PORT=5432

# Scheduler
SCHEDULER_TIMEZONE=Europe/Moscow
WEEKLY_REPORT_DAY=mon
WEEKLY_REPORT_HOUR=9
WEEKLY_REPORT_MINUTE=0

# Admin web console
# Optional. Console starts only when ADMIN_WEB_TOKEN is set.
ADMIN_WEB_TOKEN=change_this_long_random_token
ADMIN_WEB_HOST=0.0.0.0
ADMIN_WEB_PORT=8080

# Telegram Mini App
# Must be a public HTTPS URL that points to this service through a reverse proxy.
WEB_APP_ENABLED=1
WEB_APP_URL=https://monitor.example.com/app/
WEB_APP_AUTH_MAX_AGE_SECONDS=86400
WEB_APP_MAX_SITES_PER_USER=50
WEB_APP_CHECK_TIMEOUT_SECONDS=10
WEB_APP_AGENT_TIMEOUT_SECONDS=5

# Agent WebSocket server
# Public URL for agents usually goes through TLS reverse proxy:
# wss://your-domain.example/ws/agents
AGENT_WS_TOKEN=change_this_agent_token
AGENT_WS_HOST=0.0.0.0
AGENT_WS_PORT=8090
AGENT_WS_PATH=/ws/agents
AGENT_WS_PUBLISH_HOST=0.0.0.0

# Agent checks integration
AGENT_CHECKS_ENABLED=1
AGENT_CHECK_TIMEOUT_SECONDS=30
AGENT_ALERT_CHECK_TIMEOUT_SECONDS=3
AGENT_BACKGROUND_CHECK_TIMEOUT_SECONDS=5
